---
import type { CollectionEntry } from 'astro:content';

interface Props {
  members: CollectionEntry<'team'>[];
  serviceTitle: string;
}

const { members, serviceTitle } = Astro.props;
---

{members.length > 0 && (
  <section class="section section-light service-team">
    <div class="container-audex">
      <div class="section-header">
        <h2>Notre équipe en {serviceTitle}</h2>
        <p>Ces avocats et avocates pratiquent dans ce domaine.</p>
      </div>
      <div class="service-team-grid">
        {members.map((m) => (
          <a href={`/notre-equipe/${m.id}/`} class="service-team-card">
            <div class="service-team-photo">
              {m.data.photo
                ? <img src={m.data.photo} alt={m.data.name} loading="lazy" width="160" height="160" />
                : <div class="service-team-no-photo" />}
            </div>
            <p class="service-team-name">
              {m.data.name}{m.data.credentials ? `, ${m.data.credentials}` : ''}
            </p>
            <p class="service-team-role">{m.data.role}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .service-team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 2rem;
    justify-items: center;
    max-width: 900px;
    margin: 0 auto;
  }
  .service-team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    padding: 1.5rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-white);
    transition: box-shadow var(--transition), transform 0.15s ease;
    width: 100%;
  }
  .service-team-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }
  .service-team-photo {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1rem;
    background: var(--color-light);
    flex-shrink: 0;
  }
  .service-team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .service-team-no-photo {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-light) 0%, var(--color-border) 100%);
  }
  .service-team-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-navy);
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }
  .service-team-role {
    font-size: 0.82rem;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }
</style>
